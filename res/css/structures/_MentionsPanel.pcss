.mx_MentionsPanel {
    display: flex;
    flex-direction: column;
    height: 100%;

    .mx_MentionsPanel_header {
        padding: 16px;
        border-bottom: 1px solid $quinary-content;

        h2 {
            margin: 0;
            font: var(--cpd-font-heading-sm-semibold);
            color: $primary-content;
        }
    }

    .mx_MentionsPanel_list {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .mx_MentionsPanel_item {
        margin: 0;
        
        .mx_MentionsPanel_roomButton {
            width: 100%;
            padding: 12px 16px;
            border: none;
            background: transparent;
            cursor: pointer;
            text-align: left;
            display: block;

            &:hover {
                background-color: $quinary-content;
            }

            &:focus {
                background-color: $quinary-content;
                outline: 2px solid $accent;
                outline-offset: -2px;
            }
        }

        .mx_MentionsPanel_roomInfo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .mx_MentionsPanel_roomAvatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;

            .mx_MentionsPanel_avatar {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .mx_MentionsPanel_avatarPlaceholder {
                width: 100%;
                height: 100%;
                background-color: $accent;
                color: $button-primary-fg-color;
                display: flex;
                align-items: center;
                justify-content: center;
                font: var(--cpd-font-body-md-semibold);
                font-weight: var(--cpd-font-weight-semibold);
            }
        }

        .mx_MentionsPanel_roomDetails {
            flex: 1;
            min-width: 0;

            .mx_MentionsPanel_roomName {
                font: var(--cpd-font-body-md-semibold);
                font-weight: var(--cpd-font-weight-semibold);
                color: $primary-content;
                margin-bottom: 2px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .mx_MentionsPanel_mentionCount {
                font: var(--cpd-font-body-sm-regular);
                color: $secondary-content;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        }
    }

    .mx_MentionsPanel_empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        padding: 32px;
        text-align: center;

        .mx_MentionsPanel_emptyIcon {
            width: 64px;
            height: 64px;
            background-color: $quaternary-content;
            mask-image: url("@vector-im/compound-design-tokens/icons/mention.svg");
            mask-position: center;
            mask-size: contain;
            mask-repeat: no-repeat;
            margin-bottom: 16px;
        }

        h3 {
            font: var(--cpd-font-heading-md-semibold);
            font-weight: var(--cpd-font-weight-semibold);
            color: $primary-content;
            margin: 0 0 8px 0;
        }

        p {
            font: var(--cpd-font-body-md-regular);
            color: $secondary-content;
            margin: 0;
            max-width: 400px;
        }
    }
}
