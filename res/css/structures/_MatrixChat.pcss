.mx_MatrixChat_splash {
    position: relative;
    height: 100%;
}

.mx_MatrixChat_wrapper {
    display: flex;

    width: 100%;
    height: 100%;

    flex-direction: column;
}

.mx_MatrixChat_Header_Wrapper {
    display: flex;
    width: 100%;
    height: 40px;
    gap: 16px;
    align-items: center;
    padding: 0;
    z-index: 100;

}

.explore_container {
    height: 40px;
    width: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    &:hover {
        background-color: var(--background);
        border-color: var(--primary-color);
    }
}

.mx_Header_actions {
    display: flex;
    gap: 8px;
    margin-right: auto;
    align-items: center;



    .mx_RoomSearch {
        background-color: var(--background) !important;
        border-radius: 8px !important;
        border: 2px solid var(--border-color) !important;
        width: 280px !important;
        height: 40px !important;
        .mx_RoomSearch_shortcutPrompt {
           padding: 8px 12px !important;
        }
    }
}

.mx_UserMenu {
    margin-left: auto;
    .mx_UserMenu_name {
        display: none;
    }   
}

.mx_Header_exploreButton {
    width: 24px;
    height: 24px;
    background: var(--cpd-color-icon-secondary);
    mask-image: url("$(res)/img/element-icons/roomlist/explore.svg");
    mask-size: contain;
    border: none;
    cursor: pointer;
    
    &:hover {
        background: var(--cpd-color-icon-primary);
    }
}

.mx_MatrixToolbar {
    order: 1;

    height: 40px;
}

.mx_MatrixChat {
    position: relative;
    width: 100%;
    height: 100%;

    display: flex;
    gap: 12px;
    flex: 1;
    min-height: 0;
}

/* not the left panel, and not the resize handle, so the roomview and friends */
.mx_MatrixChat > :not(.mx_LeftPanel):not(.mx_SpacePanel):not(.mx_ResizeHandle):not(.mx_LeftPanel_outerWrapper):not(.mx_ToggleSidebar) {

    flex: 1 1 0;
    min-width: 0;

    /* To fix https://github.com/vector-im/element-web/issues/3298 where Safari
       needed height 100% all the way down to the HomePage. Height does not
       have to be auto, empirically.
    */
    padding: 16px 16px 16px 16px;
    background: #ffffff;
    border-radius: 24px;
}

.mx_MatrixChat > .mx_ResizeHandle--horizontal:hover {
    position: relative;

    &::before {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        height: 64px; /* to match width of the ones on roomlist */
        width: 4px;
        border-radius: 4px;

        content: " ";

        background-color: $primary-content;
        opacity: 0.8;
    }
}


.mx_main_body_panel {
    display: flex;
    height: 100%;
    padding-top: 20px;
    gap: 16px;
}