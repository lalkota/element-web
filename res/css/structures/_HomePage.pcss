.mx_HomePage {
    max-width: 960px;
    width: 100%;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
}

.mx_HomePage_default {
    text-align: center;
    display: flex;

    .mx_HomePage_default_wrapper {
        margin: auto;
        width: 100%;
    }

    img {
        height: 48px;
    }

    h1 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-32px;
        line-height: 1.375;
        margin-bottom: 4px;
    }

    h2 {
        margin-top: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-18px;
        line-height: $font-25px;
        color: $muted-fg-color;
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
    }

    .mx_HomePage_default_buttons {
        display: flex;
        margin: 20px auto 0;
        width: fit-content;
        flex-direction: column;
        min-width: 360px;

        .mx_AccessibleButton {
            padding: 15px 15px 15px 100px;
            background: white;
            width: 100%;
            min-height: 100px;
            margin-bottom: 20px;
            position: relative;
            display: flex;
            align-items: center;
            border-radius: 24px;
            vertical-align: top;
            word-break: break-word;
            box-sizing: border-box;
            border: 1px solid #EAECF0;
            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-15px;
            line-height: $font-20px;
            color: #000; /* on all themes */

            &::before {
                top: 20px;
                left: 25px; 
                width: 60px;
                height: 60px;
                content: "";
                position: absolute;
                background-repeat: no-repeat;
                background-size: contain;
            }

            .right-arrow {
                background-image: url("$(res)/img/element-icons/right-arrow.svg");
                width: 40px;
                height: 40px;
                background-repeat: no-repeat;
                background-size: contain;
                margin-left: auto;
                opacity: 0.3;
            }

            &.mx_HomePage_button_sendDm {
                background: linear-gradient(180deg,rgba(255, 255, 255, 1) 0%, rgba(229, 242, 255, 1) 100%);
            }

            &.mx_HomePage_button_explore {
                background: linear-gradient(180deg,rgba(63, 221, 120, 0) 0%, rgba(103, 29, 180, 0.2) 100%);
            }

            &.mx_HomePage_button_createGroup {
                background: linear-gradient(180deg,rgba(255, 1, 118, 0) 0%, rgba(255, 1, 118, 0.2) 100%);
            }

            &.mx_HomePage_button_sendDm::before {
                background-image: url("$(res)/img/element-icons/dm.svg");
            }

            &.mx_HomePage_button_explore::before {
                background-image: url("$(res)/img/element-icons/explore-rooms.svg");
            }

            &.mx_HomePage_button_createGroup::before {
                background-image: url("$(res)/img/element-icons/group-chat.svg");
            }

            &:hover {
                 box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.10);
                 .right-arrow {
                     opacity: 1;
                 }
            }
        }
    }
}
