.mx_ToggleSidebar {
    display: flex;
    flex-direction: column;
    width: 320px;
    height: 100%;
    background-color: var(--cpd-color-bg-canvas-default);
    border-right: 1px solid var(--border-color);
    transition: width 0.3s ease-in-out;
    z-index: 10;

    &.mx_ToggleSidebar--collapsed {
        width: 64px;
    }
}

.mx_ToggleSidebar_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    min-height: 64px;
    background-color: #ffffff;
}

.mx_ToggleSidebar_logo {
    display: flex;
    align-items: center;
    gap: 8px;
}

.mx_ToggleSidebar_logoText {
    font-size: 20px;
    font-weight: 700;
    color: #1f2937;
    letter-spacing: -0.5px;
}

.mx_ToggleSidebar_logoIcon {
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 4px;
    position: relative;
    
    &::after {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 12px;
        height: 12px;
        background-color: white;
        border-radius: 2px;
    }
}

.mx_ToggleSidebar_toggleButton {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

.mx_ToggleSidebar_toggleIcon {
    width: 16px;
    height: 16px;
    background-color: var(--cpd-color-icon-secondary);
    mask-image: url("$(res)/img/element-icons/roomlist/collapse-off.svg");
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    transition: transform 0.3s ease;

    .mx_ToggleSidebar--collapsed & {
        transform: rotate(180deg);
    }
}

.mx_ToggleSidebar_nav {
    flex: 1;
    padding: 16px 0;
    overflow-y: auto;
}

.mx_ToggleSidebar_list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mx_ToggleSidebar_listItem {
    padding: 0 12px;
}

.mx_ToggleSidebar_button {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 12px 16px;
    border-radius: 8px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    gap: 12px;
    min-height: 48px;

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    &.mx_ToggleSidebar_button--active {
        background-color: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-text-on-solid-primary);

        .mx_ToggleSidebar_icon {
            background-color: var(--cpd-color-icon-on-solid-primary);
        }
    }

    .mx_ToggleSidebar--collapsed & {
        justify-content: center;
        padding: 12px;
    }
}

.mx_ToggleSidebar_icon {
    width: 24px;
    height: 24px;
    background-color: var(--cpd-color-icon-secondary);
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    flex-shrink: 0;

    &.mx_ToggleSidebar_icon--home {
        mask-image: url("$(res)/img/element-icons/roomlist/home.svg");
    }

    &.mx_ToggleSidebar_icon--messages {
        mask-image: url("$(res)/img/element-icons/roomlist/message.svg");
    }

    &.mx_ToggleSidebar_icon--video {
        mask-image: url("$(res)/img/element-icons/roomlist/video.svg");
    }

    &.mx_ToggleSidebar_icon--people {
        mask-image: url("$(res)/img/element-icons/roomlist/people.svg");
    }

    &.mx_ToggleSidebar_icon--calendar {
        mask-image: url("$(res)/img/element-icons/roomlist/calendar.svg");
    }
}

.mx_ToggleSidebar_label {
    font-size: 14px;
    font-weight: 500;
    color: var(--cpd-color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.3s ease;

    .mx_ToggleSidebar--collapsed & {
        opacity: 0;
        width: 0;
    }
}

.mx_ToggleSidebar_footer {
    padding: 16px 20px;
    border-top: 1px solid var(--border-color);
    background-color: #ffffff;
}

/* New styles for updated component structure */
.mx_ToggleSidebar_content {
    flex: 1;
    overflow-y: auto;
    padding: 16px 0;
}

.mx_ToggleSidebar_section {
    margin-bottom: 24px;
}

.mx_ToggleSidebar_sectionHeader {
    display: flex;
    align-items: center;
    padding: 8px 20px;
    margin-bottom: 8px;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
    &:hover {
        background-color: #f3f4f6;
        border-radius: 8px;
    }
}

.mx_ToggleSidebar_sectionChevron {
    width: 16px;
    height: 16px;
    background-color: #6b7280;
    mask-image: url("$(res)/img/element-icons/roomlist/chevron-down.svg");
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    margin-right: 8px;
    transition: transform 0.2s ease;
    
    &.mx_ToggleSidebar_sectionChevron--collapsed {
        transform: rotate(-90deg);
    }
}

.mx_ToggleSidebar_sectionTitle {
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.mx_ToggleSidebar_sectionList {
    list-style: none;
    margin: 0;
    padding: 0 10px;
}

.mx_ToggleSidebar_sectionItem {
    margin-bottom: 2px;
}

.mx_ToggleSidebar_sectionButton {
    display: flex;
    align-items: center;
    padding: 10px 20px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    border-radius: 0;
    position: relative;

    &:hover {
        background-color: #f3f4f6;
        border-radius: 8px;
    }

    &.mx_ToggleSidebar_sectionButton--active {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(209, 229, 250, 0.2) 100%);
        box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
        inner-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    /* Unique active item styles */
    &.mx_ToggleSidebar_sectionButton--active-home {
        background-color: #eff6ff;
        color: #1d4ed8;
        
    }

    &.mx_ToggleSidebar_sectionButton--active-chats {
        color: #D84C10;
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(216, 76, 16, 0.2) 100%);

    }

    &.mx_ToggleSidebar_sectionButton--active-meet {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(63, 221, 120, 0.2) 100%);
        color: #3FDD78;
    }

    &.mx_ToggleSidebar_sectionButton--active-room {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(122, 90, 255, 0.2) 100%);
        color: #7A5AF8;
    }

    &.mx_ToggleSidebar_sectionButton--active-calendar {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(245, 158, 11, 0.2) 100%);
        color: #92400e;
    }

    &.mx_ToggleSidebar_sectionButton--active-phoenix {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.2) 100%);
        color: #991b1b;
    }

    &.mx_ToggleSidebar_sectionButton--active-katherine {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(12, 74, 110, 0.2) 100%);
        color: #0c4a6e;
    }

    &.mx_ToggleSidebar_sectionButton--active-group {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(6, 95, 70, 0.2) 100%);
        color: #065f46;
    }

    &.mx_ToggleSidebar_sectionButton--active-roomname {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(139, 33, 168, 0.2) 100%);
        color: #6b21a8;
    }

    &.mx_ToggleSidebar_sectionButton--active-newlist {
        background: linear-gradient(270deg,rgba(255, 255, 255, 1) 0%, rgba(139, 33, 168, 0.2) 100%);
        color: #374151;
    }
}

.mx_ToggleSidebar_sectionIcon {
    width: 20px;
    height: 20px;
    background-color: #6b7280;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    margin-right: 12px;
    flex-shrink: 0;

    &.mx_ToggleSidebar_sectionIcon--home {
        background-color: #3b82f6;
        mask-image: url("$(res)/img/element-icons/roomlist/home.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--chats {
        background-color: #D84C10;
        mask-image: url("$(res)/img/element-icons/roomlist/message.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--meet {
        background-color: #10b981;
        mask-image: url("$(res)/img/element-icons/roomlist/video.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--room {
        background-color: #8b5cf6;
        mask-image: url("$(res)/img/element-icons/roomlist/people.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--calendar {
        background-color: #F59E0B;
        mask-image: url("$(res)/img/element-icons/roomlist/calendar.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--user {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6);
        margin-right: 12px;
        position: relative;
        
        &::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 16px;
            height: 16px;
            background-color: white;
            mask-image: url("$(res)/img/element-icons/roomlist/people.svg");
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;
        }
    }

    &.mx_ToggleSidebar_sectionIcon--group {
        background-color: #10b981;
        mask-image: url("$(res)/img/element-icons/roomlist/people.svg");
    }

    &.mx_ToggleSidebar_sectionIcon--plus {
        background-color: #6b7280;
        mask-image: url("$(res)/img/element-icons/roomlist/plus-circle.svg");
    }
}

.mx_ToggleSidebar_sectionLabel {
    font-size: 14px;
    font-weight: 500;
    color: #374151;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mx_ToggleSidebar_count {
    background-color: #3FDD78;
    color: white;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 12px;
    min-width: 20px;
    text-align: center;
    margin-left: auto;
}

.mx_ToggleSidebar_notifications,
.mx_ToggleSidebar_settings {
    display: flex;
    align-items: center;
    padding: 10px 0;
    cursor: pointer;
    transition: background-color 0.2s ease;
    
    &:hover {
        background-color: #F3F4F6;
    }
}

.mx_ToggleSidebar_notificationIcon,
.mx_ToggleSidebar_settingsIcon {
    width: 20px;
    height: 20px;
    background-color: #6b7280;
    margin-right: 12px;
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
}

.mx_ToggleSidebar_notificationIcon {
    mask-image: url("$(res)/img/element-icons/notifications.svg");
}

.mx_ToggleSidebar_settingsIcon {
    mask-image: url("$(res)/img/element-icons/roomlist/dialpad.svg");
}

.mx_ToggleSidebar_notificationLabel,
.mx_ToggleSidebar_settingsLabel {
    font-size: 14px;
    color: #374151;
}

.mx_ToggleSidebar_user {
    display: flex;
    align-items: center;
    padding: 12px 0;
    margin: 16px 0;
    border-radius: 8px;
    background: var(--background-color);
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
    inner-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
}

.mx_ToggleSidebar_userAvatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    margin-right: 12px;
    position: relative;
    
    &::after {
        content: "YQ";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-size: 14px;
        font-weight: 600;
    }
}

.mx_ToggleSidebar_userInfo {
    flex: 1;
}

.mx_ToggleSidebar_userName {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 2px;
}

.mx_ToggleSidebar_userEmail {
    display: block;
    font-size: 12px;
    color: #6b7280;
}

.mx_ToggleSidebar_theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
}

.mx_ToggleSidebar_themeIcon {
    width: 20px;
    height: 20px;
    background-color: #f59e0b;
    margin-right: 12px;
    mask-image: url("$(res)/img/element-icons/roomlist/dark-light-mode.svg");
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
}

.mx_ToggleSidebar_themeLabel {
    font-size: 14px;
    color: #374151;
    flex: 1;
}

.mx_ToggleSidebar_themeDark {
    color: #9ca3af;
    font-size: 14px;
}

/* Collapsed state styles */
.mx_ToggleSidebar--collapsed {
    .mx_ToggleSidebar_logoText,
    .mx_ToggleSidebar_sectionTitle,
    .mx_ToggleSidebar_sectionLabel,
    .mx_ToggleSidebar_count,
    .mx_ToggleSidebar_notificationLabel,
    .mx_ToggleSidebar_settingsLabel,
    .mx_ToggleSidebar_userInfo,
    .mx_ToggleSidebar_themeLabel,
    .mx_ToggleSidebar_themeDark {
        display: none;
    }
    
    .mx_ToggleSidebar_header {
        justify-content: center;
        padding: 16px 12px;
    }
    
    .mx_ToggleSidebar_logo {
        display: none;
    }
    
    .mx_ToggleSidebar_content {
        padding: 16px 8px;
    }
    
    .mx_ToggleSidebar_sectionHeader {
        padding: 8px 12px;
        justify-content: center;
    }
    
    .mx_ToggleSidebar_sectionButton {
        padding: 10px 12px;
        justify-content: center;
    }
    
    .mx_ToggleSidebar_sectionIcon {
        margin-right: 0;
    }
    
    .mx_ToggleSidebar_footer {
        padding: 16px 12px;
    }
    
    .mx_ToggleSidebar_notifications,
    .mx_ToggleSidebar_settings,
    .mx_ToggleSidebar_theme {
        justify-content: center;
    }
    
    .mx_ToggleSidebar_notificationIcon,
    .mx_ToggleSidebar_settingsIcon,
    .mx_ToggleSidebar_themeIcon {
        margin-right: 0;
    }
    
    .mx_ToggleSidebar_user {
        justify-content: center;
    }
    
    .mx_ToggleSidebar_userAvatar {
        margin-right: 0;
    }
}

/* Responsive behavior */
@media (max-width: 768px) {
    .mx_ToggleSidebar {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        transform: translateX(-100%);
        transition: transform 0.3s ease-in-out;

        &.mx_ToggleSidebar--open {
            transform: translateX(0);
        }

        &.mx_ToggleSidebar--collapsed {
            width: 240px; /* Keep full width on mobile when open */
        }
    }
}
