.mx_FileModal_wrapper {
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    .mx_Dialog_border {
        border-radius: 20px !important;
        max-width: 90%;
        height: 100vh;
    }
    .mx_Dialog {
        padding: 0 !important;
        height: 100vh;
        width: 100%;
        padding: 0;
        max-width: 100%;
    }

    .mx_FileModal {
        margin: 0 auto;
    }
}

.mx_FileModal {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.mx_FileModal_header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    flex-shrink: 0;
}

.mx_FileModal_filename {
    flex: 1;
    margin: 0;
    padding-right: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_FileModal_actions {
    display: flex;
    gap: 8px;
}

.mx_FileModal_downloadButton,
.mx_FileModal_closeButton {
    background: none;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    color: var(--primary-content);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;

    &:hover {
        background-color: var(--background-hover);
    }
}

.mx_FileModal_closeButton {
    font-size: 20px;
    line-height: 1;
    width: 32px;
    height: 32px;
}

.mx_FileModal_content {
    flex: 1;
    overflow: auto;
    display: flex;
    flex-direction: column;
    min-height: 200px;
    padding: 16px;
}

/* Loading state */
.mx_FileModal_loading,
.mx_FileModal_error,
.mx_FileModal_unsupported {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 24px;
    text-align: center;
    color: var(--primary-content);
}

.mx_FileModal_loading .mx_Spinner {
    margin-bottom: 16px;
}

.mx_FileModal_error {
    color: var(--warning-color);
}

.mx_FileModal_downloadPrompt {
    margin-top: 16px;
    color: var(--secondary-content);
    font-size: 14px;
}

/* Image content */
.mx_FileModal_imageContainer {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    overflow: auto;
}

.mx_FileModal_image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

/* PDF content */
.mx_FileModal_pdfContainer {
    flex: 1;
    overflow: hidden;
}

.mx_FileModal_pdf {
    width: 100%;
    height: 100%;
    border: none;
}

/* Text content */
.mx_FileModal_textContainer {
    flex: 1;
    overflow: auto;
    background: var(--background);
    padding: 16px;
    border-radius: 4px;
    white-space: pre-wrap;
    font-family: monospace;
    font-size: 14px;
    line-height: 1.5;
    color: var(--primary-content);
}

/* Video content */
.mx_FileModal_videoContainer {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
}

.mx_FileModal_video {
    max-width: 100%;
    max-height: 100%;
    outline: none;
}

/* Audio content */
.mx_FileModal_audioContainer {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.mx_FileModal_audio {
    width: 100%;
    max-width: 500px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .mx_FileModal_wrapper {
        width: 95%;
        height: 90%;
    }
    
    .mx_FileModal_header {
        padding: 8px 12px;
    }
    
    .mx_FileModal_content {
        padding: 8px;
    }
}
