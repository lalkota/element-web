.mx_CopyableText {
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
    width: max-content;
    max-width: 100%;

    &.mx_CopyableText_border {
        overflow: auto;
        margin-top: 10px;
        gap: 10px;

        .mx_InviteDialog_footer_link {
            border-radius: 5px;
            padding: 12px 12px 12px 48px;
            border: 1px solid var(--border-color);
            color: var(--cpd-color-gray-1300);
            background-color: var(--background);
            width: 100%;
            position: relative;
            &::before {
                content: "";
                mask-image: url("$(res)/img/element-icons/roomlist/message.svg");
                mask-position: center center;
                mask-repeat: no-repeat;
                mask-size: contain;
                background-color: #D84C10;
                width: 1.4em;
                height: 1.4em;
                display: block;
                background-repeat: no-repeat;
                position: absolute;
                left: 16px;
            }
        }
    }

    .mx_CopyableText_copyButton {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
        cursor: pointer;
        padding: 12px 18px;
        position: sticky;
        right: 0;
        top: 0.15em;
        text-align: center;
        border-radius: 4px;
        border: 1px solid var(--cpd-color-primary-light);
        color: var(--cpd-color-bg-action-primary-rest);
        background-color: var(--cpd-color-primary-light);

        &::before {
            content: "";
            mask-image: url("$(res)/img/element-icons/copy.svg");
            mask-position: center center;
            mask-repeat: no-repeat;
            mask-size: contain;
            background-color: var(--cpd-color-bg-action-primary-rest);
            width: 1em;
            height: 1em;
            display: block;
            background-repeat: no-repeat;
        }
    }
}
