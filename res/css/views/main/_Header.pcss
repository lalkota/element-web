.mx_Header {
    background-color: var(--cpd-color-bg-canvas-default);
    border-bottom: 1px solid var(--cpd-color-border-interactive-primary);
    padding: 12px 16px;
    box-sizing: border-box;
    height: 64px; /* Fixed height for the header */
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100; /* Ensure header stays above other content */
}

.mx_Header_container {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px; /* Max width for content */
    margin: 0 auto;
    padding: 0 16px;
}

.mx_Header_search {
    flex: 1;
    max-width: 600px;
    margin-right: 16px;
}

.mx_Header_searchBox {
    width: 100%;
    background-color: var(--cpd-color-bg-subtle-primary);
    border-radius: 8px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.mx_Header_searchBox:focus-within {
    border-color: var(--cpd-color-border-focused);
    box-shadow: 0 0 0 2px var(--cpd-color-border-focused);
}

.mx_Header_userMenu {
    margin-left: auto;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .mx_Header {
        padding: 8px 12px;
        height: 56px;
    }
    
    .mx_Header_search {
        max-width: 100%;
        margin-right: 8px;
    }
}

/* Dark theme adjustments */
.mx_theme-dark .mx_Header_searchBox {
    background-color: var(--cpd-color-bg-canvas-default);
    border-color: var(--cpd-color-border-interactive-secondary);
}

.mx_theme-dark .mx_Header_searchBox:focus-within {
    border-color: var(--cpd-color-border-focused);
}
