.mx_RoomFilesView {
    height: calc(100% - 40px);
    overflow-y: auto;
    background: var(--cpd-color-bg-canvas-default);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    
    &--loading,
    &--empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: calc(100% - 40px);
        text-align: center;
        gap: 8px;
        padding: 30px;
    }
}

.mx_RoomFilesView_content {
    padding: 20px 30px;
}

.mx_RoomFilesView_section {
    margin-bottom: 32px;
    
    &:last-child {
        margin-bottom: 0;
    }
}

.mx_RoomFilesView_sectionHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    
    h3 {
        font: var(--cpd-font-heading-sm-semibold);
        color: var(--cpd-color-text-primary);
        margin: 0;
    }
    
    .mx_RoomFilesView_seeAll {
        color: var(--cpd-color-text-action-accent);
        font: var(--cpd-font-body-sm-medium);
        text-decoration: none;
        cursor: pointer;
        
        &:hover {
            text-decoration: underline;
        }
    }
}

.mx_RoomFilesView_list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.mx_RoomFilesView_item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background-color: var(--cpd-color-bg-canvas-default);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 12px;
    transition: all 0.2s ease;
    cursor: pointer;
    
    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
        border-color: var(--cpd-color-border-interactive-primary);
    }
}

.mx_RoomFilesView_fileIcon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--cpd-color-bg-subtle-primary);
    border-radius: 8px;
    font-size: 24px;
}

.mx_RoomFilesView_fileInfo {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mx_RoomFilesView_filename {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
    margin: 0;
    word-break: break-word;
    line-height: 1.2;
}

.mx_RoomFilesView_metadata {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    
    span {
        display: flex;
        align-items: center;
        gap: 4px;
    }
}

.mx_RoomFilesView_actions {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 1;
    background-color: var(--cpd-color-bg-subtle-primary);
    border-radius: 8px;
    padding: 8px;
    transition: opacity 0.2s ease;
}

.mx_RoomFilesView_actionButton {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--cpd-color-icon-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    position: relative;
    background: transparent;
    border: 1px solid transparent;
    
    &:hover {
        border-color: var(--cpd-color-border-interactive-primary);
        color: var(--cpd-color-icon-primary);
        transform: scale(1.05);
    }
    
    &:active {
        transform: scale(0.98);
    }
    
    svg {
        width: 20px;
        height: 20px;
    }
}

.mx_RoomFilesView_emptyTitle {
    color: var(--cpd-color-text-primary);
    margin-bottom: 8px;
}

.mx_RoomFilesView_emptyDescription {
    color: var(--cpd-color-text-secondary);
    max-width: 300px;
}

/* Responsive behavior */
@media (max-width: 768px) {
    .mx_RoomFilesView {
        padding: 12px;
    }
    
    .mx_RoomFilesView_item {
        padding: 10px;
        gap: 10px;
    }
    
    .mx_RoomFilesView_fileIcon {
        font-size: 20px;
        width: 28px;
        height: 28px;
    }
    
    .mx_RoomFilesView_actions {
        gap: 4px;
    }
    
    .mx_RoomFilesView_actionButton {
        width: 24px;
        height: 24px;
        
        svg {
            width: 20px;
            height: 20px;
        }
    }
}

@media (max-width: 480px) {
    .mx_RoomFilesView_item {
        padding: 8px;
        gap: 8px;
    }
    
    .mx_RoomFilesView_fileIcon {
        font-size: 18px;
        width: 24px;
        height: 24px;
    }
    
    .mx_RoomFilesView_actions {
        gap: 2px;
        
        /* Show actions by default on very small screens */
        opacity: 1;
    }
    
    .mx_RoomFilesView_actionButton {
        width: 20px;
        height: 20px;
        
        svg {
            width: 10px;
            height: 10px;
        }
    }
}
