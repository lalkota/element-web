.mx_MentionsAndThreads {
    border-bottom: 1px solid var(--cpd-color-border-subtle);
    margin-bottom: 8px;
    padding: 0 8px;
}

.mx_MentionsAndThreads_item {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
    transition: background-color 0.1s ease;

    &:last-child {
        margin-bottom: 0;
    }

    &:hover {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    &:active {
        background-color: var(--cpd-color-bg-subtle-primary);
    }
}

.mx_MentionsAndThreads_icon {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    flex-shrink: 0;
}

.mx_MentionsAndThreads_mentionsIcon {
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5c.55 0 1 .45 1 1s-.45 1-1 1c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7c0 .55-.45 1-1 1s-1-.45-1-1c0-2.76-2.24-5-5-5z' fill='%23737D8C'/%3E%3C/svg%3E");
}

.mx_MentionsAndThreads_threadsIcon {
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1zM4 11a1 1 0 100 2h4a1 1 0 100-2H4zM11 12a1 1 0 011-1h5a1 1 0 110 2h-5a1 1 0 01-1-1zM12 15a1 1 0 100 2h5a1 1 0 100-2h-5z' fill='%23737D8C'/%3E%3C/svg%3E");
}

.mx_MentionsAndThreads_label {
    flex: 1;
    font-size: 14px;
    font-weight: 500;
    color: var(--cpd-color-text-primary);
    line-height: 20px;
}

/* Notification badge positioning */
.mx_MentionsAndThreads_item .mx_NotificationBadge {
    margin-left: auto;
    flex-shrink: 0;
}

/* Mentions specific styling */
.mx_MentionsAndThreads_mentions {
    background: linear-gradient(270deg, rgba(255, 255, 255, 1) 0%, rgba(212, 247, 255, 0.5) 100%);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    .mx_MentionsAndThreads_mentionsIcon {
        background-image: url("$(res)/img/element-icons/roomlist/mentions.svg");
    }
}

/* Threads specific styling */
.mx_MentionsAndThreads_threads {
    background: linear-gradient(270deg, rgba(255, 255, 255, 1) 0%, rgba(209, 229, 250, 0.5) 100%);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    .mx_MentionsAndThreads_threadsIcon {
        background-image: url("$(res)/img/element-icons/roomlist/threads.svg");
    }
}

/* Dark theme adjustments */
.mx_Theme_dark {
    .mx_MentionsAndThreads_mentionsIcon {
        background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 2C5.58 2 2 5.58 2 10s3.58 8 8 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5c.55 0 1 .45 1 1s-.45 1-1 1c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7c0 .55-.45 1-1 1s-1-.45-1-1c0-2.76-2.24-5-5-5z' fill='%2300D924'/%3E%3C/svg%3E");
    }

    .mx_MentionsAndThreads_threadsIcon {
        background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h8a1 1 0 110 2H4a1 1 0 01-1-1zM4 11a1 1 0 100 2h4a1 1 0 100-2H4zM11 12a1 1 0 011-1h5a1 1 0 110 2h-5a1 1 0 01-1-1zM12 15a1 1 0 100 2h5a1 1 0 100-2h-5z' fill='%230086E6'/%3E%3C/svg%3E");
    }
}
