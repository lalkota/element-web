.mx_AuthHeaderLogo {
    margin-top: 0;
    flex: 1;
    padding: 0 0;
    background-color: #F9FAFB;
    background-size: cover;
    background-position: center;
}

.mx_AuthHeaderLogo img {
    width: 100%;
    max-height: 100vh;
}

@media only screen and (max-width: 480px) {
    .mx_AuthHeaderLogo {
        display: none;
    }
}
